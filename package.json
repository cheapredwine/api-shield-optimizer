{
  "name": "api-shield-optimizer",
  "version": "0.1.0",
  "description": "Cloudflare API Shield / Web Assets Endpoint Optimization Agent",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
