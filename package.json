  },
  "keywords": ["cloudflare", "api-shield", "web-assets", "security", "api-discovery"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "commander": "^12.0.0"
  }
}
