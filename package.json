{
  "name": "api-shield-optimizer",
  "version": "0.3.0",
  "description": "Cloudflare API Shield endpoint optimization CLI — proposes which discovered endpoints to save or ignore",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "api-shield-optimizer": "dist/cli.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheapredwine/api-shield-optimizer.git"
  },
  "bugs": {
    "url": "https://github.com/cheapredwine/api-shield-optimizer/issues"
  },
  "homepage": "https://github.com/cheapredwine/api-shield-optimizer#readme",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "propose": "tsx src/cli.ts propose",
    "review": "tsx src/cli.ts review",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": ["cloudflare", "api-shield", "cli", "security", "api-discovery"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "commander": "^12.0.0"
  }
}
